# Copy to .env (git-ignored). Only the keys you actually use need a value.
# The wizard (`python -m jarvis_brain configure` / `keys`) writes here for you.

# --- big brain: API-key path (kind=api in models.yaml) ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_API_KEY=   # ollama.com/settings/keys — Ollama Cloud, provider: ollama

# --- big brain: subscription path (kind=cli) needs NO key here ---
# just have `claude`, `codex`, or `gemini` installed and logged in.

# --- specialized providers (image / video / audio / …) ---
KIE_API_KEY=
HIGGSFIELD_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=
