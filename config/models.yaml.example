# config/models.yaml — the brain registry.
#
# Written by the first-run wizard (`python -m jarvis_brain configure`). Edit by
# hand any time; it hot-reloads on the next turn. Git-ignored — it's yours.
# Secrets never live here — only the NAME of the .env var that holds them.

brain:
  # local | big  — the default mode. "use the big brain" switches for one turn.
  mode: local

  local:
    provider: ollama
    base_url: http://localhost:11434
    model: qwen2.5:3b-instruct   # a tool-capable model; re-check ollama.com/library
    keep_alive: -1               # keep the model resident between turns
    context: 8192
    temperature: 0.7
    languages: [en, hi]

  # "big brain" — tried in order on a big-brain trigger, then mode reverts to
  # local. Two kinds of entry:
  big:
    # kind: cli — use a coding-agent CLI you're already signed into. No key,
    #             cost is your existing subscription.
    - kind: cli
      cli: claude              # claude | codex | gemini
      # model: claude-opus-5   # optional, passed through to the CLI

    # kind: api — use a hosted API with a key from .env (api_key_env).
    - kind: api
      provider: openrouter     # openrouter | openai | anthropic | groq | deepseek | ...
      model: deepseek/deepseek-chat
      api_key_env: OPENROUTER_API_KEY
      # base_url: https://openrouter.ai/api/v1   # optional; sane default per provider

  monthly_cloud_cap_inr: 1000        # API spend only; kind=cli calls count as 0
  never_escalate_tags: [private, health, finance_personal, family]

# Specialized providers — keys for non-chat work (image, video, music, ocr,
# embeddings, …). Add any capability name you want. The secret is in .env under
# api_key_env; only its name is here. Wired for use in later phases; configured
# now via `python -m jarvis_brain keys`.
specialized:
  image:
    provider: kie.ai
    base_url: https://api.kie.ai
    api_key_env: KIE_API_KEY
    model: flux-1.1-pro
  video:
    provider: higgsfield
    base_url: https://platform.higgsfield.ai/api
    api_key_env: HIGGSFIELD_API_KEY
